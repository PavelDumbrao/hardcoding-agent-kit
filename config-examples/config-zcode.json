{
  "_комментарий": "Пример конфига ZCode: ~/.zcode/cli/config.json. Хуки включаются блоком hooks, MCP-серверы добавляются в mcp.servers. Токены НЕ вписывать текстом — используй ${ИМЯ_ПЕРЕМЕННОЙ} или вызов security/keychain, как в примере supabase.",
  "mcp": {
    "servers": {
      "context7": { "type": "http", "url": "http://127.0.0.1:9800/servers/context7/mcp" },
      "tavily": { "type": "http", "url": "http://127.0.0.1:9800/servers/tavily/mcp" },
      "b24-dev-mcp": { "type": "http", "url": "https://mcp-dev.bitrix24.tech/mcp" },
      "supabase": {
        "command": "/bin/sh",
        "args": ["-c", "SUPABASE_ACCESS_TOKEN=$(security find-generic-password -s supabase-mcp -w 2>/dev/null) exec npx -y @supabase/mcp-server-supabase@0.11.0 --features=account,database,docs"]
      },
      "playwright": { "command": "npx", "args": ["-y", "@playwright/mcp@0.0.60"] },
      "my-server-with-token": {
        "command": "npx",
        "args": ["-y", "@example/mcp-server"],
        "env": { "API_TOKEN": "${MY_API_TOKEN_из_окружения}" }
      }
    }
  },
  "hooks": {
    "enabled": true,
    "maxOutputBytes": 262144,
    "events": {
      "SessionStart": [{ "hooks": [{ "type": "command", "command": "python3 ~/.zcode/hooks/session_start.py", "timeout": 30, "statusMessage": "Загружаю память проекта" }] }],
      "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "python3 ~/.zcode/hooks/user_prompt_submit.py", "timeout": 10, "statusMessage": "Маршрутизация запроса" }] }],
      "PreToolUse": [{ "matcher": "Bash|Write|Edit|MultiEdit", "hooks": [{ "type": "command", "command": "python3 ~/.zcode/hooks/pre_tool_use.py", "timeout": 10, "statusMessage": "Проверяю безопасность" }] }],
      "PostToolUse": [{ "hooks": [{ "type": "command", "command": "python3 ~/.zcode/hooks/post_tool_use.py", "timeout": 20, "statusMessage": "Телеметрия" }] }],
      "Stop": [{ "hooks": [{ "type": "command", "command": "python3 ~/.zcode/hooks/stop_notify.py", "timeout": 60, "statusMessage": "Уведомление в Telegram" }] }]
    }
  }
}
