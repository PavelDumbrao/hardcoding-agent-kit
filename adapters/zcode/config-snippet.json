{
  "hooks": {
    "enabled": true,
    "events": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "HCAK_RUNTIME=zcode python3 ~/.hardcoding-agent-kit/hooks/session_start.py",
              "timeout": 20,
              "statusMessage": "Загружаю continuity"
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Bash|Read|Write|Edit|MultiEdit",
          "hooks": [
            {
              "type": "command",
              "command": "HCAK_RUNTIME=zcode python3 ~/.hardcoding-agent-kit/hooks/pre_tool_use.py",
              "timeout": 10,
              "statusMessage": "Проверяю безопасность"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "HCAK_RUNTIME=zcode python3 ~/.hardcoding-agent-kit/hooks/post_tool_use.py",
              "timeout": 10
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "HCAK_RUNTIME=zcode python3 ~/.hardcoding-agent-kit/hooks/stop_notify.py",
              "timeout": 20,
              "statusMessage": "Telegram-уведомление"
            }
          ]
        }
      ]
    }
  }
}
