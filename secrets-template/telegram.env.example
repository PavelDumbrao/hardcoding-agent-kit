# Скопируй в ~/.zcode/secrets/telegram.env и заполни своими значениями (chmod 600).
# Бот создаётся у @BotFather за 2 минуты. chat_id узнаётся у @userinfobot или из Bot API getUpdates.
TELEGRAM_BOT_TOKEN=<токен_бота_от_BotFather>
TELEGRAM_CHAT_ID=<твой_chat_id>
# Необязательно, для красивого форматирования уведомлений (OpenAI-совместимый endpoint):
LLM_FORMAT_BASE_URL=https://<твой_llm_шлюз>/v1
LLM_FORMAT_API_KEY=<ключ_шлюза>
LLM_FORMAT_MODEL=<модель_например_gpt-5.4-mini>
